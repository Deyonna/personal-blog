---
import { getCollection } from 'astro:content';
import TagCloud from './TagCloud.astro';
import SearchIcon from './SearchIcon.astro';

const base = import.meta.env.BASE_URL;

// Build a combined tag cloud from writeups + knowledge + tools so the sidebar
// reflects everything on the site, not just one collection.
const writeups = await getCollection('writeups', ({ data }) => !data.draft);
const knowledge = await getCollection('knowledge', ({ data }) => !data.draft);
const tools = await getCollection('tools', ({ data }) => !data.draft);

const nav = [
  { href: `${base}/`, label: 'home' },
  { href: `${base}/writeups`, label: 'writeups' },
  { href: `${base}/knowledge`, label: 'knowledge' },
  { href: `${base}/tools`, label: 'tools' },
  { href: `${base}/about`, label: 'about' },
];

const current = Astro.url.pathname.replace(/\/$/, '');

// Social links. Brand paths are from Simple Icons (CC0); the contact icon is
// an outline envelope. Replace the '#' placeholders with profile URLs.
const social = [
  {
    label: 'GitHub',
    href: 'https://github.com/Deyonna',
    external: true,
    path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/pgkinala',
    external: true,
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    label: 'HackTheBox',
    href: 'https://app.hackthebox.com/users/103145',
    external: true,
    path: 'M11.996 0a1.119 1.119 0 0 0-.057.003.9.9 0 0 0-.236.05.907.907 0 0 0-.165.079L1.936 5.675a.889.889 0 0 0-.445.77v11.093a.889.889 0 0 0 .47.784l9.598 5.541.054.029v.002a.857.857 0 0 0 .083.035l.012.004c.028.01.056.018.085.024.01.001.011.003.016.004a.93.93 0 0 0 .296.015.683.683 0 0 0 .062-.008c.01-.002.019-.002.026-.005a.94.94 0 0 0 .204-.068.92.92 0 0 0 .064-.034l9.534-5.504a.889.889 0 0 0 .48-.79V6.446v-.002a.88.88 0 0 0-.06-.314c-.001-.002-.001-.005-.003-.009a.899.899 0 0 0-.4-.453L12.491.13a.899.899 0 0 0-.495-.13Zm.02 2.047 7.772 4.486-7.773 4.49-7.774-4.49 7.775-4.486zM3.271 8.074l7.855 4.535v8.988l-7.855-4.537V8.074zm17.464 0v8.986l-7.855 4.537v-8.988l7.855-4.535z',
  },
  {
    label: 'Contact',
    href: 'mailto:deyonna@proton.me',
    stroke: true,
    path: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm-1 1 9 7 9-7',
  },
];
---

<aside id="sidebar" class="sidebar">
  <a href={`${base}/`} class="brand mono">0x<span>deyonna</span></a>
  <p class="role mono">SOC analyst<br />DFIR · malware · CTF</p>

  <button type="button" class="search-trigger mono" data-search-open>
    <span class="search-trigger__label"><SearchIcon />search</span><kbd>ctrl K</kbd>
  </button>

  <nav class="nav mono" aria-label="Primary">
    {nav.map((item) => {
      const path = item.href.replace(/\/$/, '');
      const active = path === current || (path !== base && current.startsWith(path));
      return (
        <a
          href={item.href}
          class={active ? 'nav-link active' : 'nav-link'}
          aria-current={active ? 'page' : undefined}
        >
          <span class="nav-arrow" aria-hidden="true">{active ? '→' : ''}</span>{item.label}
        </a>
      );
    })}
  </nav>

  <div class="section">
    <div class="eyebrow">Topics</div>
    <TagCloud writeups={writeups} knowledge={[...knowledge, ...tools]} limit={10} />
  </div>

  <div class="social">
    {social.map((s) => (
      <a
        href={s.href}
        aria-label={s.label}
        title={s.label}
        {...(s.external && s.href !== '#' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
          {...(s.stroke
            ? { fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
            : { fill: 'currentColor' })}>
          <path d={s.path} />
        </svg>
      </a>
    ))}
  </div>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    border-right: 1px solid var(--border);
    background: var(--bg-alt);
    padding: 30px 22px;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }
  .brand {
    font-size: 1.05rem;
    color: var(--text);
    font-weight: 500;
    letter-spacing: -0.03em;
    border-bottom: none;
  }
  .brand span { color: var(--accent-bright); }
  .role {
    font-size: 0.7rem;
    color: var(--text-faint);
    line-height: 1.7;
    margin: 8px 0 26px;
  }
  .search-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 26px;
    padding: 7px 10px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--text-faint);
    font-size: 0.72rem;
    cursor: pointer;
  }
  .search-trigger:hover { color: var(--text-muted); border-color: var(--text-faint); }
  .search-trigger__label { display: flex; align-items: center; gap: 7px; }
  .search-trigger kbd { font: inherit; font-size: 0.62rem; opacity: 0.8; }
  .nav { display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px; }
  .nav-link {
    font-size: 0.82rem;
    color: var(--text-muted);
    border-bottom: none;
    display: flex;
  }
  /* Fixed gutter: every item reserves the same space for the arrow so the
     labels line up in one column whether or not the item is active. */
  .nav-arrow { flex: 0 0 2ch; }
  .nav-link:hover { color: var(--text); }
  .nav-link.active { color: var(--accent-bright); }

  .section { margin-bottom: auto; }
  .eyebrow { margin-bottom: 10px; }

  .social {
    display: flex;
    justify-content: flex-start;
    gap: 6px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--text-muted);
    border-bottom: none;
  }
  /* Pull the first icon's hit area into the gutter so its glyph lines up
     with the text edge above. */
  .social a:first-child { margin-left: -8px; }
  .social a:hover { color: var(--accent-bright); background: var(--border-soft); }

  @media (max-width: 780px) {
    .sidebar {
      width: 100%;
      height: auto;
      position: static;
      display: none;
    }
    .sidebar.sidebar--open { display: flex; }
    .section { margin-bottom: 24px; }
  }
</style>
