---
import { getCollection } from 'astro:content';
import TagCloud from './TagCloud.astro';
import SearchIcon from './SearchIcon.astro';
import { social } from '../data/social';

const base = import.meta.env.BASE_URL;

// Build a combined tag cloud from writeups + knowledge + tools so the sidebar
// reflects everything on the site, not just one collection.
const writeups = await getCollection('writeups', ({ data }) => !data.draft);
const knowledge = await getCollection('knowledge', ({ data }) => !data.draft);
const tools = await getCollection('tools', ({ data }) => !data.draft);

const nav = [
  { href: `${base}/`, label: 'home' },
  { href: `${base}/writeups`, label: 'writeups' },
  { href: `${base}/knowledge`, label: 'knowledge' },
  { href: `${base}/tools`, label: 'tools' },
  { href: `${base}/about`, label: 'about' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
---

<aside id="sidebar" class="sidebar">
  <a href={`${base}/`} class="brand mono">0x<span>deyonna</span></a>
  <p class="role mono">SOC analyst<br />DFIR · malware · CTF</p>

  <button type="button" class="search-trigger mono" data-search-open>
    <span class="search-trigger__label"><SearchIcon />search</span><kbd>ctrl K</kbd>
  </button>

  <nav class="nav mono" aria-label="Primary">
    {nav.map((item) => {
      const path = item.href.replace(/\/$/, '');
      const active = path === current || (path !== base && current.startsWith(path));
      return (
        <a
          href={item.href}
          class={active ? 'nav-link active' : 'nav-link'}
          aria-current={active ? 'page' : undefined}
        >
          <span class="nav-arrow" aria-hidden="true">{active ? '→' : ''}</span>{item.label}
        </a>
      );
    })}
  </nav>

  <div class="section">
    <div class="eyebrow">Topics</div>
    <TagCloud writeups={writeups} knowledge={[...knowledge, ...tools]} limit={10} />
  </div>

  <div class="social">
    {social.map((s) => {
      // Entries without an href (Discord) show the handle on hover instead.
      const Tag = s.href ? 'a' : 'span';
      return (
        <Tag
          href={s.href}
          aria-label={s.href ? s.label : `${s.label}: ${s.handle}`}
          title={s.href ? s.label : `${s.label}: ${s.handle}`}
          {...(s.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
            {...(s.stroke
              ? { fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
              : { fill: 'currentColor' })}>
            <path d={s.path} />
          </svg>
        </Tag>
      );
    })}
  </div>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    border-right: 1px solid var(--border);
    background: var(--bg-alt);
    padding: 30px 22px;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }
  .brand {
    font-size: 1.05rem;
    color: var(--text);
    font-weight: 500;
    letter-spacing: -0.03em;
    border-bottom: none;
  }
  .brand span { color: var(--accent-bright); }
  .role {
    font-size: 0.7rem;
    color: var(--text-faint);
    line-height: 1.7;
    margin: 8px 0 26px;
  }
  .search-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 26px;
    padding: 7px 10px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--text-faint);
    font-size: 0.72rem;
    cursor: pointer;
  }
  .search-trigger:hover { color: var(--text-muted); border-color: var(--text-faint); }
  .search-trigger__label { display: flex; align-items: center; gap: 7px; }
  .search-trigger kbd { font: inherit; font-size: 0.62rem; opacity: 0.8; }
  .nav { display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px; }
  .nav-link {
    font-size: 0.82rem;
    color: var(--text-muted);
    border-bottom: none;
    display: flex;
  }
  /* Fixed gutter: every item reserves the same space for the arrow so the
     labels line up in one column whether or not the item is active. */
  .nav-arrow { flex: 0 0 2ch; }
  .nav-link:hover { color: var(--text); }
  .nav-link.active { color: var(--accent-bright); }

  .section { margin-bottom: auto; }
  .eyebrow { margin-bottom: 10px; }

  /* Pinned to the bottom of the sidebar: the negative bottom margin eats
     into the sidebar's padding so the row sits close to the edge. */
  .social {
    display: flex;
    justify-content: space-between;
    margin-top: 24px;
    margin-bottom: -14px;
    padding: 10px 6px 0;
    border-top: 1px solid var(--border);
  }
  .social > * {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    color: var(--text-faint);
    border-bottom: none;
  }
  /* Pull the outer icons' hit areas into the gutter so the glyphs sit a
     small, even inset (the row's side padding) from the divider's ends. */
  .social > :first-child { margin-left: -7.5px; }
  .social > :last-child { margin-right: -7.5px; }
  .social > :hover { color: var(--accent-bright); background: var(--border-soft); }

  @media (max-width: 780px) {
    .sidebar {
      width: 100%;
      height: auto;
      position: static;
      display: none;
    }
    .sidebar.sidebar--open { display: flex; }
    .section { margin-bottom: 24px; }
  }
</style>
