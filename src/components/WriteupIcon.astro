---
// Platform avatar for a writeup (the `icon` frontmatter image), or a
// monogram circle when none is set. Real icons are shown uncropped because
// they carry their own shape (HTB machines are round, Sherlocks are shields).
// Used by the machine card and the writeup list.
import { Image } from 'astro:assets';

const { data, size = 96 } = Astro.props;
// HTB forensics challenges without their own icon get a fingerprint.
const isForensicsChallenge =
  data.platform === 'HackTheBox' &&
  data.type === 'Challenge' &&
  data.tags?.includes('forensics');
// "Precious - HTB Walkthrough" -> "P"
const initial = data.title.split(' - ')[0].trim().charAt(0).toUpperCase();
const dims = `width:${size}px;height:${size}px`;
---

{data.icon ? (
  <Image src={data.icon} alt="" width={size * 2} class="icon" style={dims} />
) : (
  <div class="icon icon--fallback" style={dims} aria-hidden="true">
    {isForensicsChallenge ? (
      // Fingerprint from Lucide (ISC).
      <svg width={Math.round(size * 0.5)} height={Math.round(size * 0.5)} viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4" />
        <path d="M14 13.12c0 2.38 0 6.38-1 8.88" />
        <path d="M17.29 21.02c.12-.6.43-2.3.5-3.02" />
        <path d="M2 12a10 10 0 0 1 18-6" />
        <path d="M2 16h.01" />
        <path d="M21.8 16c.2-2 .131-5.354 0-6" />
        <path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2" />
        <path d="M8.65 22c.21-.66.45-1.32.57-2" />
        <path d="M9 6.8a6 6 0 0 1 9 5.2v2" />
      </svg>
    ) : (
      <span style={`font-size:${Math.round(size * 0.44)}px`}>{initial}</span>
    )}
  </div>
)}

<style>
  .icon {
    flex: none;
    display: block;
    object-fit: contain;
  }
  .icon--fallback {
    border-radius: 50%;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 30% 25%, var(--accent-wash), var(--surface) 70%);
  }
  .icon--fallback svg { color: var(--accent-text); }
  .icon--fallback span {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1;
    color: var(--accent-text);
  }
</style>
