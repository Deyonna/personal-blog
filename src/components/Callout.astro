---
// Usage in .mdx:  <Callout type="warning">Text here</Callout>
const { type = 'note' } = Astro.props;
const styles = {
  note:    { label: 'Note',    icon: 'ℹ' },
  tip:     { label: 'Tip',     icon: '✦' },
  warning: { label: 'Warning', icon: '⚠' },
  flag:    { label: 'Flag',    icon: '⚑' },
};
const s = styles[type] ?? styles.note;
---
<div class={`callout callout--${type}`}>
  <div class="callout__label mono"><span aria-hidden="true">{s.icon}</span> {s.label}</div>
  <div class="callout__body"><slot /></div>
</div>

<style>
  .callout {
    border: 1px solid var(--border);
    border-left-width: 3px;
    border-radius: 6px;
    padding: 12px 16px;
    margin: 1.4em 0;
    background: var(--surface);
    font-size: 0.95rem;
  }
  .callout__label {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .callout__body :global(p:last-child) { margin-bottom: 0; }

  .callout--note    { border-left-color: var(--text-faint); }
  .callout--note    .callout__label { color: var(--text-muted); }
  .callout--tip     { border-left-color: var(--accent); }
  .callout--tip     .callout__label { color: var(--accent-text); }
  .callout--warning { border-left-color: #b8860b; }
  .callout--warning .callout__label { color: #d9a520; }
  .callout--flag    { border-left-color: var(--accent-bright); background: var(--accent-wash); }
  .callout--flag    .callout__label { color: var(--accent-text); }
</style>
