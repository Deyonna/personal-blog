---
import { getCollection } from 'astro:content';
import WriteupLayout from '../../layouts/WriteupLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writeups', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
// Locked writeups are never rendered, so their body (and headings) never
// reach the built HTML or the search index.
const { Content, headings } = entry.data.locked
  ? { Content: null, headings: [] }
  : await entry.render();
---
<WriteupLayout entry={entry} headings={headings}>
  {Content && <Content />}
</WriteupLayout>
