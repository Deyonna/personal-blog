---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="404" description="Page not found.">
  <div class="eyebrow">404</div>
  <h1>Not found</h1>
  <p class="muted">That page doesn't exist - it may have moved or never existed.</p>
  <p class="mono" style="margin-top:1em"><a href={`${base}/`}>← back home</a></p>
</BaseLayout>
