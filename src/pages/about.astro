---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { timeline } from '../data/timeline';
import { social } from '../data/social';

const certifications = [
  { code: 'SC-200', name: 'Security Operations Analyst', issuer: 'Microsoft' },
  { code: 'AZ-900', name: 'Azure Fundamentals', issuer: 'Microsoft' },
  { code: 'MS-900', name: 'Microsoft 365 Fundamentals', issuer: 'Microsoft' },
];

const skills = [
  'Log Analysis',
  'Malware Analysis',
  'Forensics',
  'Cryptography',
  'Burp Suite',
  'Wireshark',
  'Volatility',
];
---
<BaseLayout title="About" description="About 0xdeyonna: SOC analyst, CTF player and security researcher.">
  <article class="prose about">
    <header class="bio">
      <Image src={avatar} alt="Deyonna's avatar" width={192} class="bio__avatar" />
      <div class="bio__text">
        <div class="eyebrow">About</div>
        <h1>0x<span class="accent">deyonna</span></h1>
        <p class="bio__tagline mono">SOC Analyst · CTF Player · Security Researcher</p>
      </div>
    </header>

    <p>
      Hello everyone! I'm Pinelopi Gkinala, aka Deyonna, and this is my personal
      blog. I'm interested in all things cybersecurity, from both red and blue
      team perspectives. I enjoy solving challenges on HackTheBox and take part
      in CTF competitions with friends and colleagues when I have the time. I
      also like writing about my experiences and sharing what I learn with the
      community. I am a strong advocate of women in cybersecurity and I  hope to inspire more
      women to pursue a career in this field. I am currently working as a tier 2 SOC analyst at an MSP.
    </p>
    <p>
      When I'm not working or studying, I enjoy painting, reading, playing video
      games and watching shows. I wish the day had more than 24 hours so I could
      do everything I want to do!
    </p>

    <ul class="skills" aria-label="Skills and tools">
      {skills.map((s) => <li class="tag">{s}</li>)}
    </ul>

    <h2>Journey</h2>
    <ol class="timeline">
      {timeline.map((item) => (
        <li class="timeline__item">
          <span class="timeline__year mono">{item.year}</span>
          <h3 class="timeline__title">{item.title}</h3>
          <p class="timeline__text">{item.text}</p>
        </li>
      ))}
    </ol>

    <h2>Certifications</h2>
    <ul class="certs">
      {certifications.map((c) => (
        <li class="cert">
          <span class="cert__code mono">{c.code}</span>
          <span class="cert__name">{c.name}</span>
          <span class="cert__issuer mono">{c.issuer}</span>
        </li>
      ))}
    </ul>

    <h2>Contact</h2>
    <p>Reach out or find me on any of these:</p>
    <ul class="contact">
      {social.map((s) => {
        const Tag = s.href ? 'a' : 'span';
        return (
          <li>
            <Tag
              href={s.href}
              class="contact__link"
              {...(s.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                {...(s.stroke
                  ? { fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
                  : { fill: 'currentColor' })}>
                <path d={s.path} />
              </svg>
              <span class="contact__label">{s.label}</span>
              <span class="contact__handle mono">{s.handle}</span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </article>
</BaseLayout>

<style>
  .about { max-width: 680px; }

  /* ---------- bio header ---------- */
  .bio {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 1.6em;
  }
  .bio__avatar {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 1px solid var(--border);
    object-fit: cover;
  }
  .bio__text { min-width: 0; }
  .bio h1 {
    margin: 4px 0 6px;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .accent { color: var(--accent-bright); }
  .bio__tagline { margin: 0; font-size: 0.78rem; color: var(--text-muted); }

  .skills {
    list-style: none;
    padding: 0;
    margin: 1.4em 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .skills .tag { font-size: 0.72rem; }

  /* ---------- timeline ---------- */
  .timeline {
    list-style: none;
    margin: 1.2em 0 0;
    padding: 0 0 0 26px;
    position: relative;
  }
  /* The rail: a thin line through every dot. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: var(--border);
  }
  .timeline__item { position: relative; padding-bottom: 1.6em; }
  .timeline__item:last-child { padding-bottom: 0; }
  .timeline__item::before {
    content: '';
    position: absolute;
    left: -26px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent-dim);
  }
  /* Newest entry gets the filled accent dot. */
  .timeline__item:first-child::before {
    background: var(--accent);
    border-color: var(--accent-bright);
  }
  .timeline__year { font-size: 0.72rem; letter-spacing: 0.08em; color: var(--accent-text); }
  .timeline__title { margin: 2px 0 4px; font-size: 1.05rem; padding: 0; }
  .timeline__text { margin: 0; font-size: 0.92rem; color: var(--text-muted); }

  /* ---------- certifications ---------- */
  .certs {
    list-style: none;
    padding: 0;
    margin: 1.2em 0 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  }
  .cert {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent-dim);
    border-radius: 8px;
  }
  .cert__code {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--accent-text);
    letter-spacing: -0.01em;
  }
  .cert__name { font-size: 0.92rem; color: var(--text); line-height: 1.35; }
  .cert__issuer {
    margin-top: auto;
    padding-top: 6px;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* ---------- contact ---------- */
  .contact { list-style: none; padding: 0; margin: 0.8em 0 0; }
  .contact li { margin: 0; border-top: 1px solid var(--border-soft); }
  .contact li:first-child { border-top: none; }
  .contact__link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    color: var(--text-faint);
    border-bottom: none;
  }
  .contact__link svg { flex: none; }
  .contact__label { flex: 0 0 6.5em; font-size: 0.92rem; color: var(--text); }
  .contact__handle {
    min-width: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.contact__link:hover,
  a.contact__link:hover .contact__handle { color: var(--accent-text); }

  @media (max-width: 520px) {
    .bio { gap: 16px; }
    .bio__avatar { width: 72px; height: 72px; }
  }
</style>
