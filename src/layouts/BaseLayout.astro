---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import SearchDialog from '../components/SearchDialog.astro';
import SearchIcon from '../components/SearchIcon.astro';
import CodeCopy from '../components/CodeCopy.astro';

export interface Props {
  title: string;
  description?: string;
  /** Wider content column for article pages that show the contents panel. */
  wide?: boolean;
}
const { title, description = 'Security research, DFIR notes, and CTF writeups by 0xdeyonna.', wide = false } = Astro.props;
const site = '0xdeyonna';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title === site ? title : `${title} · ${site}`}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />

  <!-- Fonts: Geist (body/UI), Lora (titles), JetBrains Mono (code) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Lora:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  <div class="topbar mono">
    <button id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="sidebar">
      <span aria-hidden="true">≡</span> menu
    </button>
    <button class="topbar__search" data-search-open aria-label="Search"><SearchIcon /> search</button>
  </div>

  <div class="layout">
    <Sidebar />
    <main id="main" class={wide ? 'content content--wide' : 'content'}>
      <slot />
    </main>
  </div>

  <SearchDialog />
  <CodeCopy />

  <script>
    // Mobile sidebar toggle. Progressive enhancement - the site is fully
    // navigable without JS; this only improves the small-screen experience.
    const btn = document.getElementById('nav-toggle');
    const sidebar = document.getElementById('sidebar');
    btn?.addEventListener('click', () => {
      const open = sidebar?.classList.toggle('sidebar--open');
      btn.setAttribute('aria-expanded', String(!!open));
    });
  </script>

  <style>
    /* Sidebar hugs the left edge; the content column is capped and
       centered in whatever width remains. */
    .layout {
      display: flex;
      min-height: 100vh;
    }
    .content {
      flex: 1;
      min-width: 0;
      max-width: calc(var(--maxw) - var(--sidebar-w));
      margin: 0 auto;
      padding: 40px 34px 80px;
    }
    .content--wide { max-width: 1060px; }
    .topbar {
      display: none;
      position: sticky;
      top: env(safe-area-inset-top, 0px);
      z-index: 20;
      background: var(--bg-alt);
      border-bottom: 1px solid var(--border);
    }
    .topbar button {
      background: none;
      border: none;
      color: var(--text);
      font: inherit;
      font-size: 0.85rem;
      padding: 12px 16px;
      cursor: pointer;
    }
    .nav-toggle { flex: 1; text-align: left; }
    .topbar__search { color: var(--text-muted) !important; display: flex; align-items: center; gap: 7px; }

    @media (max-width: 780px) {
      .layout { flex-direction: column; }
      .content { padding: 28px 20px 60px; }
      .topbar { display: flex; }
    }
  </style>
</body>
</html>
