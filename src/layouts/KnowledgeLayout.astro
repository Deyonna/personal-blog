---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const { entry, headings = [] } = Astro.props;
const { data } = entry;

// Two-way linking: find every writeup that lists this knowledge page in its
// `knowledge` frontmatter, so the reference page shows where it mattered.
const writeups = await getCollection('writeups', ({ data }) => !data.draft);
const usedIn = writeups.filter((w) => (w.data.knowledge ?? []).includes(entry.slug));
---
<BaseLayout title={data.title} description={data.description} wide>
  <div class="doc">
  <article class="prose" data-pagefind-body data-pagefind-filter="section:Knowledge">
    <div class="eyebrow" data-pagefind-ignore>{['Knowledge', data.domain].filter(Boolean).join(' · ')}</div>
    <h1>{data.title}</h1>
    <p class="lede muted">{data.description}</p>
    <div class="meta mono" data-pagefind-ignore>
      {data.tags.map((t) => <a href={`${base}/knowledge?tag=${encodeURIComponent(t)}`} class="tag" data-pagefind-filter="tag">{t}</a>)}
    </div>

    <hr />

    <slot />

    {usedIn.length > 0 && (
      <section class="usedin">
        <h2>Seen in these writeups</h2>
        <ul>
          {usedIn.map((w) => (
            <li><a href={`${base}/writeups/${w.slug}`}>{w.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <p class="back mono"><a href={`${base}/knowledge`}>← knowledge library</a></p>
  </article>
  <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<style>
  .prose { max-width: 720px; }
  .lede { font-size: 1.1rem; margin-top: 0.4em; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .usedin {
    margin-top: 3em;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 20px 16px;
    background: var(--bg-alt);
  }
  .usedin ul { padding-left: 1.1em; }
  .usedin li { margin: 0.4em 0; font-size: 0.92rem; }
  .back { margin-top: 3em; font-size: 0.8rem; }
</style>
